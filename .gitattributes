# The hooks wrapper runs in bash (RNF-0002). A CR in the shebang breaks it with
# "bad interpreter", and whoever clones on Windows cannot see why.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.pdf binary

# spur runs itself and every Spurfile through sh, which breaks on CR
# (ADR-0039). The `*` rule above already says LF; this keeps it for these files
# even if that rule changes.
spur text eol=lf
Spurfile text eol=lf
